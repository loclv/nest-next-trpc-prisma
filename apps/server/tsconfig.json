{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"declaration": false,
		"removeComments": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"target": "esnext",
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": ".",
		"types": ["node", "bun"]
	}
}
