{
	"name": "server",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nest build",
		"start": "nest start --exec bun",
		"dev": "nest start --exec bun --watch",
		"start:debug": "nest start --exec bun --debug --watch",
		"start:prod": "bun dist/main.js",
		"migrate": "prisma migrate dev",
		"studio": "prisma studio",
		"test": "bun test src",
		"test:watch": "bun --watch test src",
		"test:cov": "bun test --coverage src",
		"test:debug": "bun --inspect-brk test src",
		"test:e2e": "bun test ./test/app.e2e-spec.ts"
	},
	"dependencies": {
		"@nestjs/common": "^12.6.0",
		"@nestjs/core": "^12.6.0",
		"@nestjs/platform-express": "^12.6.0",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "7.10.1",
		"@repo/shared": "workspace:*",
		"@trpc/server": "^11.30.3",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"superjson": "^2.2.7",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.15",
		"@nestjs/schematics": "^12.0.16",
		"@nestjs/testing": "^12.6.0",
		"@types/bun": "^1.4.5",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"prisma": "7.10.1",
		"source-map-support": "^0.5.21",
		"supertest": "^7.3.2",
		"ts-loader": "^9.6.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3"
	}
}
